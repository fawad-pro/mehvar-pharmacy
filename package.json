{
  "name": "mehvar-pharmacy",
  "version": "0.0.0",
  "private": true,
  "description": "Trust-first pharmacy POS and operations platform for independent Pakistani pharmacies.",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:reset": "npm run db:reset && npm run db:setup && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db/migrate.ts",
    "db:grants": "tsx --conditions=react-server scripts/db/grants.ts",
    "db:verify": "tsx --conditions=react-server scripts/db/verify.ts",
    "db:reset": "tsx --conditions=react-server scripts/db/reset.ts",
    "db:seed": "tsx --conditions=react-server scripts/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run typecheck && npm run lint && npm run lint:ps && npm run test",
    "hooks:install": "git config core.hooksPath .githooks",
    "init": "tsx --conditions=react-server scripts/db/init.ts",
    "ops:backup": "tsx --conditions=react-server scripts/ops/backup.ts",
    "ops:restore-drill": "tsx --conditions=react-server scripts/ops/restore-drill.ts",
    "ops:support-bundle": "tsx --conditions=react-server scripts/ops/support-bundle.ts",
    "package:build": "tsx scripts/package/build.ts",
    "lint:ps": "tsx scripts/package/lint-powershell.ts",
    "package:installer": "tsx scripts/package/build-installer.ts",
    "catalog:build": "tsx --conditions=react-server scripts/catalog/build-pack.ts",
    "catalog:validate": "tsx --conditions=react-server scripts/catalog/validate.ts",
    "catalog:import": "tsx --conditions=react-server scripts/catalog/import-pack.ts",
    "catalog:csv": "tsx --conditions=react-server scripts/catalog/import-csv.ts",
    "licence:keygen": "tsx scripts/licence/keygen.ts",
    "licence:issue": "tsx scripts/licence/issue.ts",
    "licence:inspect": "tsx scripts/licence/inspect.ts",
    "licence:revoke": "tsx scripts/licence/revoke.ts",
    "db:setup": "npm run db:migrate && npm run db:grants && npm run db:seed && npm run catalog:seed",
    "catalog:seed": "npm run catalog:build -- --out dist/catalog/mehvar-catalog.json && npm run catalog:import -- dist/catalog/mehvar-catalog.json --origin dev-setup --trusted-local"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
