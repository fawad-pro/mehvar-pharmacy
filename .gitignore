# Built catalogue packs. The pack is generated from scripts/db/seed-data.ts at
# package time, never committed: a committed copy would drift from the source
# list and the drift would be invisible until a pharmacy asked why a medicine
# in the code is missing from its search.
dist/catalog/

# The founder's private record of which licences were issued to whom
# (`licence:issue` appends to it). Never committed: it carries customer names
# and live tokens.
licences.jsonl

# Trust-root PRIVATE signing keys. `licence:keygen` prints them to stdout for a
# password manager; if a founder instead saves one to a file, it must never be
# committed — a leaked private half forges licences for every pharmacy. The
# PUBLIC halves live in src/domain/trust/keys.ts and are meant to be committed.
*.key
*.pem
*-signing-key*
mehvar-*.key
