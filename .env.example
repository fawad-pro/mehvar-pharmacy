# Mehvar Pharmacy — environment template.
#
# Phase 12 §1: configuration is environment variables only, held in Railway for
# staging and production. No secrets in the repository; `.env` is gitignored and
# must stay that way.
#
# Copy to `.env` for local development:  cp .env.example .env

# local | staging | production  (Phase 12 §1 — three environments, no more)
APP_ENV=local

# The application connects as a NON-OWNING role. This is not cosmetic: Phase 9
# §5.1 REVOKEs UPDATE/DELETE on event tables from the app role, and a REVOKE
# against the role that owns the tables is silently inert. Connecting as the
# owner would leave ADR-1's immutability guarantee unenforced and looking
# enforced. See PCN-001 in docs/PLAN_CHANGE_NOTES.md.
DATABASE_URL=postgresql://mehvar_app:mehvar_app@localhost:5432/mehvar_pharmacy

# Owner connection — migrations, db:reset and db:grants only. Never the app.
DATABASE_ADMIN_URL=postgresql://mehvar:mehvar@localhost:5432/mehvar_pharmacy

# The app role db:grants creates and configures.
APP_DB_ROLE=mehvar_app
APP_DB_PASSWORD=mehvar_app

# ADR-7: own session auth. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-characters-of-random

# Next.js encrypts every Server Action reference with this key. When it is
# UNSET, Next generates a fresh random key on every build — so after an in-place
# update, any screen a cashier left open still holds actions encrypted with the
# old key, and submitting one (Save product, Pay, Settle, anything) fails to
# decrypt on the new server and returns a 404. Pinning it keeps a stable key
# across builds and restarts, so those forms keep working through an update.
# It is read at build AND run time and must match; keep it STABLE across
# releases. Generate once with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-me-with-32-bytes-base64-and-keep-it-stable

# Phase 9 §1 — single-timezone country; tenants may override in settings.
TENANT_TIME_ZONE=Asia/Karachi

# [Stage 2] The cloud licence service (roadmap Phase 3). OPTIONAL and unset at
# launch — while it is unset, online refresh is dormant and the pharmacy trades
# entirely on the licence it already holds. Setting it turns on background
# licence refresh, renewal and signed-revocation delivery. It is NEVER on the
# sale path: a timer in the Node, never a request. See src/db/licence-refresh.ts.
# MEHVAR_LICENCE_URL=https://licence.mehvar.example

# PCN-019: local (default, a shop PC with a licence file) or cloud (the shared
# Railway deployment, where entitlement is a per-tenant record). Configuration
# only — see docs/DEPLOYMENT.md. Leave unset on a developer machine.
# MEHVAR_DEPLOYMENT=local
